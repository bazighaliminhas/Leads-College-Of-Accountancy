APP_NAME="Leads College of Accountancy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Karachi
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=error

# --- Database: SQLite works out of the box. For MySQL, comment SQLite and fill MySQL. ---
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=leads_lca
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log
